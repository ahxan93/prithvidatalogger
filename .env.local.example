# Enquiry form email (src/app/api/enquiry/route.ts). Server-side only: never prefix with NEXT_PUBLIC_.
# Zoho Mail example; use smtp.zoho.in for accounts on the India data centre.
# Set the real values in .env.local and in the hosting provider's environment variables.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=enquiries@example.com
SMTP_PASS=your-zoho-app-password
# Inbox that receives enquiries.
ENQUIRY_TO=sales@example.com
# Must be SMTP_USER or an alias of that mailbox, or Zoho rejects the mail. Display name allowed.
ENQUIRY_FROM="Prithvi Data Loggers <enquiries@example.com>"

# Set to "true" in Vercel's project environment variables once
# prithvidatalogger.com is connected and verified as the custom domain.
# Until then, leave unset: the site is reachable (but noindexed) on the
# *.vercel.app preview URL, and no redirect happens. See src/proxy.ts.
PRODUCTION_DOMAIN_LIVE=
